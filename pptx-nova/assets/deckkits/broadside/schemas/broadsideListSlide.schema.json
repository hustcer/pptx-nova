{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideListSlide data",
  "type": "object",
  "required": ["kicker", "title", "items"],
  "properties": {
    "section": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.7,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "page": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.7,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "kicker": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.5,
        "heightIn": 0.35,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 32,
        "widthIn": 4.5,
        "heightIn": 2,
        "lineHeight": 1.05,
        "maxLines": 3
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "x-slotBudget": {
          "fontPt": 16,
          "widthIn": 6.51,
          "heightIn": 1.005,
          "lineHeight": 1.2,
          "maxLines": 3
        }
      }
    },
    "footerLeft": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 7.3,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "footerRight": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.35,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "itemIcons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "x-slotRole": "control",
        "x-iconFamily": "tabler-outline",
        "x-slotProbeValue": "book",
        "description": "Optional bundled Tabler outline icon; replaces the peer marker. Default stroke 1.2; maximum 1.5."
      },
      "description": "Semantic icons in the same order as items; provide exactly one per item.",
      "x-slotRole": "control"
    }
  },
  "additionalProperties": false,
  "$id": "pptx-nova-slide/broadside/broadsideListSlide",
  "x-generatedBudgetsFrom": "broadside/design.json",
  "x-capacityCheck": "resolve-broadside-components/v1"
}
