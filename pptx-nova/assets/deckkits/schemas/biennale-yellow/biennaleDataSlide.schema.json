{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleDataSlide",
  "title": "biennaleDataSlide data schema",
  "type": "object",
  "required": ["title", "label", "stats", "bars"],
  "properties": {
    "title": {
      "type": "string",
      "x-slotBudget": { "maxLines": 2, "fontPt": 36, "widthIn": 3.4 }
    },
    "label": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.5 }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["value", "suffix", "label", "description"],
        "properties": {
          "value": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 72, "widthIn": 1.3 }
          },
          "suffix": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 72, "widthIn": 0.5 }
          },
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.8 }
          },
          "description": {
            "type": "string",
            "x-slotBudget": { "maxLines": 4, "fontPt": 10.5, "widthIn": 3.1 }
          }
        },
        "additionalProperties": false
      }
    },
    "bars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "pct", "value", "accent"],
        "properties": {
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.56 }
          },
          "pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "value": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.75 }
          },
          "accent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
