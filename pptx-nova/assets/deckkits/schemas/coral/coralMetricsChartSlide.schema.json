{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralMetricsChartSlide",
  "title": "coralMetricsChartSlide data schema",
  "type": "object",
  "required": ["section", "title", "stat", "statLabel", "chart", "metrics"],
  "properties": {
    "section": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.5, "widthIn": 1.6 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 32, "widthIn": 4.7 } },
    "stat": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 32, "widthIn": 1.5 } },
    "statLabel": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 1.4 }
    },
    "chart": {
      "type": "object",
      "required": ["categories", "series"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "properties": {
              "name": { "type": "string" },
              "values": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": { "type": "number" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 18, "widthIn": 1.0 }
          },
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
