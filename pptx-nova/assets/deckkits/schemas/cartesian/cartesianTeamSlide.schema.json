{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianTeamSlide",
  "title": "cartesianTeamSlide data schema",
  "type": "object",
  "required": ["label", "title", "members"],
  "properties": {
    "label": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 12.2 } },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 36, "widthIn": 12.2 } },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["initial", "name", "role"],
        "properties": {
          "initial": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 24, "widthIn": 1.6 }
          },
          "name": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 14.5, "widthIn": 1.7 }
          },
          "role": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 7.8, "widthIn": 2.0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
