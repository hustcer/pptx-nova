{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissGridTypesSlide",
  "title": "swissGridTypesSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "x-slotBudget": { "maxItems": 4 },
      "items": {
        "type": "object",
        "properties": {
          "num": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 10.5, "widthIn": 1.4 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 15.5, "widthIn": 3.0 }
          },
          "subtitle": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 2.5 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 10.2, "widthIn": 3.3 }
          },
          "diagram": {
            "type": "string",
            "enum": ["manuscript", "columns", "modular", "mosaic", "hierarchical"],
            "description": "右侧装饰图形样式（hierarchical 与 mosaic 同形）；未指定时按条目顺序自动轮换 mosaic → columns → manuscript → modular，避免同页四个图形完全相同。"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
