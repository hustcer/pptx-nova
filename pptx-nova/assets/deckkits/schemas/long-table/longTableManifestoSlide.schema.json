{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableManifestoSlide",
  "title": "longTableManifestoSlide data schema",
  "type": "object",
  "required": ["mark", "eyebrow", "title", "paragraphs", "signature", "source"],
  "properties": {
    "mark": {
      "type": "string",
      "maxLength": 2,
      "x-slotBudget": { "maxLines": 1, "fontPt": 18, "widthIn": 0.28 }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 48,
      "x-slotBudget": { "maxLines": 1, "fontPt": 10.5, "widthIn": 2.6 }
    },
    "title": {
      "type": "string",
      "maxLength": 56,
      "x-slotBudget": { "maxLines": 3, "fontPt": 48, "widthIn": 5.35 }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 210,
        "x-slotBudget": { "maxLines": 4, "fontPt": 14.4, "widthIn": 5.86 }
      }
    },
    "signature": {
      "type": "string",
      "maxLength": 36,
      "x-slotBudget": { "maxLines": 1, "fontPt": 15.5, "widthIn": 1.9 }
    },
    "source": {
      "type": "string",
      "maxLength": 96,
      "x-slotBudget": { "maxLines": 1, "fontPt": 10.5, "widthIn": 4.7 }
    }
  },
  "additionalProperties": false
}
