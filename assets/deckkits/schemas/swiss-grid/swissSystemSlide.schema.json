{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissSystemSlide",
  "title": "swissSystemSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "baseLabel": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 1.7 }
    },
    "baseValue": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 36, "widthIn": 1.8 }
    },
    "baseNote": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 2.4 }
    },
    "body": { "type": "string", "x-slotBudget": { "maxLines": 7, "fontPt": 10.5, "widthIn": 3.6 } },
    "callout": {
      "type": "string",
      "x-slotBudget": { "maxLines": 2, "fontPt": 10.4, "widthIn": 3.0 }
    },
    "measureLabels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "labels": { "type": "object" }
  },
  "additionalProperties": true
}
