{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleColophonSlide",
  "title": "biennaleColophonSlide data schema",
  "type": "object",
  "required": ["kicker", "title", "footerItems"],
  "properties": {
    "kicker": {
      "type": "string",
      "x-designSlot": "Kicker",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 3.6,
        "heightIn": 0.22,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-designSlot": "Title",
      "x-slotBudget": {
        "fontPt": 76,
        "widthIn": 6.3,
        "heightIn": 4.75,
        "lineHeight": 0.86,
        "maxLines": 5
      }
    },
    "footerItems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string",
            "x-designSlot": "FootLabel{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.25,
              "heightIn": 0.23,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "text": {
            "type": "string",
            "x-designSlot": "FootText{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.25,
              "heightIn": 0.78,
              "lineHeight": 1.15,
              "maxLines": 4
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json"
}
