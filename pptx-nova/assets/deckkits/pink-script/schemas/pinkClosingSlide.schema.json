{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkClosingSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 5.75,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.13,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.23,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.7,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Closing invitation.",
      "x-slotBudget": {
        "fontPt": 44,
        "widthIn": 6.05,
        "heightIn": 3.4,
        "lineHeight": 1,
        "maxLines": 3
      }
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Action heading.",
            "x-slotBudget": {
              "fontPt": 24,
              "widthIn": 4.41,
              "heightIn": 0.55,
              "lineHeight": 1,
              "maxLines": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Action detail.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4.41,
              "heightIn": 0.7,
              "lineHeight": 1.12,
              "maxLines": 2
            }
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-slotRole": "control",
            "x-iconFamily": "tabler-outline",
            "x-slotProbeValue": "book",
            "description": "Optional bundled Tabler outline icon; replaces the peer marker. Default stroke 1.2; maximum 1.5."
          }
        },
        "required": ["title", "description"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 3
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "actions"],
  "additionalProperties": false
}
