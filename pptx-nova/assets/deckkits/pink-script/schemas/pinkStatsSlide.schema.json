{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkStatsSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 5.75,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.13,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.23,
        "heightIn": 0.3,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.7,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Editorial assertion; explicit line breaks preserved.",
      "x-slotBudget": {
        "fontPt": 62,
        "widthIn": 6.15,
        "heightIn": 3.65,
        "lineHeight": 1,
        "maxLines": 2
      }
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Interpretation and synthetic/real evidence disclosure.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 5.25,
        "heightIn": 1.25,
        "lineHeight": 1.12,
        "maxLines": 4
      }
    },
    "stats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Explicit unit or suffix, painted smaller than value.",
            "x-slotBudget": {
              "fontPt": 48,
              "widthIn": 2.0502000000000002,
              "heightIn": 0.85,
              "lineHeight": 1,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metric label.",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 3.7998,
              "heightIn": 0.3,
              "lineHeight": 1.12,
              "maxLines": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metric context.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.7998,
              "heightIn": 1.29,
              "lineHeight": 1.12,
              "maxLines": 5
            }
          }
        },
        "required": ["value", "unit", "label", "description"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 5
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "intro", "stats"],
  "additionalProperties": false
}
