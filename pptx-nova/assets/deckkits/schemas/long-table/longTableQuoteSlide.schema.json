{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableQuoteSlide",
  "title": "longTableQuoteSlide data schema",
  "type": "object",
  "required": ["label", "quote", "author", "role"],
  "properties": {
    "label": { "type": "string", "maxLength": 36 },
    "quote": {
      "type": "string",
      "maxLength": 140,
      "x-slotBudget": { "maxLines": 3, "fontPt": 36, "widthIn": 9.9 }
    },
    "author": { "type": "string", "maxLength": 36 },
    "role": { "type": "string", "maxLength": 72 }
  },
  "additionalProperties": false
}
