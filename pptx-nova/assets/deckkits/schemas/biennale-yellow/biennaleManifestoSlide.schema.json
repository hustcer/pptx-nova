{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleManifestoSlide",
  "title": "biennaleManifestoSlide data schema",
  "type": "object",
  "required": ["quote", "attribution"],
  "properties": {
    "quote": {
      "type": "string",
      "x-designSlot": "Quote",
      "x-slotBudget": {
        "fontPt": 56,
        "widthIn": 11.65,
        "heightIn": 3.1,
        "lineHeight": 1.04,
        "maxLines": 3
      }
    },
    "attribution": {
      "type": "string",
      "x-designSlot": "Attribution",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 4.8,
        "heightIn": 0.22,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json"
}
