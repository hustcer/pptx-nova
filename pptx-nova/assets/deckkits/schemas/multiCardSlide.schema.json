{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/multiCardSlide",
  "title": "multiCardSlide data schema",
  "type": "object",
  "required": ["eyebrow", "title", "cards"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "intro": { "type": "string" },
    "cards": {
      "type": "array",
      "description": "Tuple: [accent, idx, name, items[]]",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": [
          { "type": "string" },
          { "type": "string" },
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    }
  },
  "additionalProperties": false
}
