{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/askSlide",
  "title": "askSlide data schema",
  "type": "object",
  "required": ["eyebrow", "title", "asks"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "sub": { "type": "string" },
    "asks": {
      "type": "array",
      "description": "Tuple: [accent, title, description]",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "string" }
      }
    },
    "closing": { "type": "string" },
    "closingR": { "type": "string" }
  },
  "additionalProperties": false
}
