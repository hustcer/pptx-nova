{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleDataSlide",
  "title": "biennaleDataSlide data schema",
  "type": "object",
  "required": ["title", "label", "stats", "bars"],
  "properties": {
    "title": {
      "type": "string",
      "x-designSlot": "Title",
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 5.6,
        "heightIn": 0.75,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "x-designSlot": "Label",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2.5,
        "heightIn": 0.22,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["value", "suffix", "label", "description"],
        "properties": {
          "value": {
            "type": "string",
            "x-designSlot": "Stat{i}",
            "x-slotBudget": {
              "fontPt": 62,
              "widthIn": 2.8,
              "heightIn": 1,
              "lineHeight": 0.9,
              "maxLines": 1
            }
          },
          "suffix": {
            "type": "string",
            "x-designSlot": "Stat{i}",
            "x-slotBudget": {
              "fontPt": 62,
              "widthIn": 2.8,
              "heightIn": 1,
              "lineHeight": 0.9,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "x-designSlot": "StatLabel{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.8,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "description": {
            "type": "string",
            "x-designSlot": "StatDesc{i}",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3.1,
              "heightIn": 0.7,
              "lineHeight": 1.25,
              "maxLines": 3
            }
          }
        },
        "additionalProperties": false
      }
    },
    "bars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "pct", "value", "accent"],
        "properties": {
          "label": {
            "type": "string",
            "x-designSlot": "BarYear{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 0.7,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "value": {
            "type": "string",
            "x-designSlot": "BarVal{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 0.75,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "accent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json"
}
