{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralClosingSlide",
  "title": "coralClosingSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "contacts", "socials"],
  "properties": {
    "title": { "type": "string", "x-slotBudget": { "maxLines": 2, "fontPt": 38, "widthIn": 2.9 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 3, "fontPt": 10.5, "widthIn": 3.8 }
    },
    "contacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 8.5, "widthIn": 1.2 }
          },
          "value": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 17, "widthIn": 3.05 }
          }
        },
        "additionalProperties": false
      }
    },
    "socials": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.3 } }
    }
  },
  "additionalProperties": false
}
