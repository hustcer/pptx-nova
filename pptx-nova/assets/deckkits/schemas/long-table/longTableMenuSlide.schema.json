{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableMenuSlide",
  "title": "longTableMenuSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "items"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 72,
      "x-slotBudget": { "maxLines": 1, "fontPt": 31, "widthIn": 8.2 }
    },
    "subtitle": { "type": "string", "maxLength": 40 },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string", "maxLength": 96 }
      }
    }
  },
  "additionalProperties": false
}
