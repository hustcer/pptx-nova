{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianImageStatsSlide",
  "title": "cartesianImageStatsSlide data schema",
  "type": "object",
  "required": ["imageLabel", "label", "title", "paragraphs", "stats"],
  "properties": {
    "imageLabel": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9.5, "widthIn": 1.9 }
    },
    "label": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 4.2 } },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 36, "widthIn": 5.8 } },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "x-slotBudget": { "maxLines": 4, "fontPt": 13, "widthIn": 5.8 }
      }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 24, "widthIn": 1.3 }
          },
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 7.6, "widthIn": 1.35 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
