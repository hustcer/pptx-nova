{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/benchmarkSlide",
  "title": "benchmarkSlide data schema",
  "type": "object",
  "required": ["eyebrow", "title", "tableRows", "chartData"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "tableName": { "type": "string" },
    "tableWidth": { "type": "number" },
    "tableRows": {
      "type": "array",
      "description": "2D string array: header row + data rows",
      "minItems": 2,
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "chartTitle": { "type": "string" },
    "chartName": { "type": "string" },
    "chartData": { "type": "object" },
    "calloutNum": { "type": "string" },
    "calloutText": { "type": "string" }
  },
  "additionalProperties": false
}
