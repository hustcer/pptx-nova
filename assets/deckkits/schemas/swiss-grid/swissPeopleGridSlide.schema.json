{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissPeopleGridSlide",
  "title": "swissPeopleGridSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "x-slotBudget": { "maxItems": 8 },
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 15.5, "widthIn": 2.5 }
          },
          "years": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 10.2, "widthIn": 2.5 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 4, "fontPt": 8.9, "widthIn": 2.4 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
