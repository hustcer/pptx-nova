{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissTimelineSlide",
  "title": "swissTimelineSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "x-slotBudget": { "maxItems": 5 },
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 8.2, "widthIn": 1.7 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 10.5, "widthIn": 1.9 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 4, "fontPt": 9.2, "widthIn": 1.7 }
          }
        },
        "additionalProperties": true
      }
    },
    "calloutTitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.4, "widthIn": 2.3 }
    },
    "callout": {
      "type": "string",
      "x-slotBudget": { "maxLines": 2, "fontPt": 8.4, "widthIn": 5.6 }
    },
    "calloutHighlights": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
