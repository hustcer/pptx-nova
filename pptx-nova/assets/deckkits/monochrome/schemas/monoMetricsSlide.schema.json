{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monochrome metrics",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "pattern": "\\S",
      "description": "Content-owned structural label; Latin uppercase is an authoring preference, never an automatic transform.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "pattern": "\\S",
      "description": "Preserved heading or quotation, including intentional line breaks.",
      "x-slotBudget": {
        "fontPt": 30.72,
        "widthIn": 10.733,
        "heightIn": 1.05,
        "lineHeight": 1.08,
        "maxLines": 2
      }
    },
    "source": {
      "type": "string",
      "pattern": "\\S",
      "description": "Provenance/date/qualification; synthetic samples must be identified explicitly.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.733,
        "heightIn": 0.32,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "\\S",
            "description": "Display string, including units. Not used to derive chart geometry.",
            "x-slotBudget": {
              "fontPt": 54,
              "widthIn": 3.32723,
              "heightIn": 1.0433333333333334,
              "lineHeight": 1.08,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "pattern": "\\S",
            "description": "Metric description",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.4043333333333337,
              "heightIn": 1,
              "lineHeight": 1.15,
              "maxLines": 3
            }
          },
          "note": {
            "type": "string",
            "pattern": "\\S",
            "description": "Metric basis/source",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.36126,
              "heightIn": 0.9933333333333334,
              "lineHeight": 1.15,
              "maxLines": 4
            }
          }
        },
        "required": ["value", "label", "note"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": ["section", "title", "source", "metrics"],
  "additionalProperties": false
}
