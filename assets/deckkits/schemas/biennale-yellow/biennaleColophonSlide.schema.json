{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleColophonSlide",
  "title": "biennaleColophonSlide data schema",
  "type": "object",
  "required": ["kicker", "title", "footerItems"],
  "properties": {
    "kicker": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 3.6 }
    },
    "title": {
      "type": "string",
      "x-slotBudget": { "maxLines": 5, "fontPt": 76, "widthIn": 6.3 }
    },
    "footerItems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.6 }
          },
          "text": {
            "type": "string",
            "x-slotBudget": { "maxLines": 3, "fontPt": 9, "widthIn": 3.0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
