{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianCardsSlide",
  "title": "cartesianCardsSlide data schema",
  "type": "object",
  "required": ["label", "title", "cards"],
  "properties": {
    "label": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 12.2 } },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 36, "widthIn": 12.2 } },
    "cards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["marker", "title", "body"],
        "properties": {
          "marker": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 0.37 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 15.5, "widthIn": 3.25 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 5, "fontPt": 10.8, "widthIn": 3.25 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
