{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralTimelineSlide",
  "title": "coralTimelineSlide data schema",
  "type": "object",
  "required": ["section", "title", "steps"],
  "properties": {
    "section": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.5, "widthIn": 1.4 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 5.0 } },
    "steps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["phase", "title", "desc"],
        "properties": {
          "phase": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.4 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 1.3 }
          },
          "desc": {
            "type": "string",
            "x-slotBudget": { "maxLines": 4, "fontPt": 9, "widthIn": 1.7 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
