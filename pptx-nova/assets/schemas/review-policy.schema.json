{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurify.io/schemas/pptx-nova-review-policy.v1.schema.json",
  "title": "pptx-nova hash-bound reviewed finding policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindings", "reviewedFindings"],
  "properties": {
    "schemaVersion": {
      "const": "pptx-nova-review-policy/v1"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256"],
      "properties": {
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "reviewedFindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewedFinding"
      }
    }
  },
  "$defs": {
    "reviewedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "disposition", "target", "expected", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "const": "empty-placeholder"
        },
        "disposition": {
          "const": "accepted"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slideIndex", "part", "shapeId", "placeholder"],
          "properties": {
            "slideIndex": {
              "type": "integer",
              "minimum": 0
            },
            "part": {
              "type": "string",
              "pattern": "^ppt/slides/slide[1-9][0-9]*\\.xml$"
            },
            "shapeId": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "minLength": 1 }
              ]
            },
            "placeholder": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "idx"],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "idx": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "string", "minLength": 1 }
                  ]
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textEmpty"],
          "properties": {
            "textEmpty": {
              "const": true
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
