{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralPillarsSplitSlide",
  "title": "coralPillarsSplitSlide data schema",
  "type": "object",
  "required": ["number", "title", "items"],
  "properties": {
    "number": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 40, "widthIn": 1.35 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 2, "fontPt": 28, "widthIn": 1.9 } },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 1.4 }
          },
          "text": {
            "type": "string",
            "x-slotBudget": { "maxLines": 3, "fontPt": 10.5, "widthIn": 5.0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
