{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableClosingSlide",
  "title": "longTableClosingSlide data schema",
  "type": "object",
  "required": ["mark", "eyebrow", "title", "body", "site", "cta", "footer"],
  "properties": {
    "mark": { "type": "string", "maxLength": 2 },
    "eyebrow": { "type": "string", "maxLength": 48 },
    "title": {
      "type": "string",
      "maxLength": 56,
      "x-slotBudget": { "maxLines": 2, "fontPt": 49, "widthIn": 6.2 }
    },
    "body": {
      "type": "string",
      "maxLength": 220,
      "x-slotBudget": { "maxLines": 3, "fontPt": 14.1, "widthIn": 6.0 }
    },
    "site": { "type": "string", "maxLength": 36 },
    "cta": { "type": "string", "maxLength": 28 },
    "footer": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "maxLength": 72 }
      }
    }
  },
  "additionalProperties": false
}
