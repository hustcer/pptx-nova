{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleCoverSlide",
  "title": "biennaleCoverSlide data schema",
  "type": "object",
  "required": ["dateRange", "title", "subline", "footerItems"],
  "properties": {
    "dateRange": {
      "type": "string",
      "x-designSlot": "DateRail",
      "x-slotBudget": {
        "fontPt": 42,
        "widthIn": 2.86,
        "heightIn": 1.35,
        "lineHeight": 0.9,
        "maxLines": 2
      }
    },
    "title": {
      "type": "string",
      "x-designSlot": "Title",
      "x-slotBudget": {
        "fontPt": 92,
        "widthIn": 7.25,
        "heightIn": 2.95,
        "lineHeight": 0.86,
        "maxLines": 2
      }
    },
    "subline": {
      "type": "string",
      "x-designSlot": "Subline",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 3.7,
        "heightIn": 0.22,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "footerItems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string",
            "x-designSlot": "FootLabel{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.06,
              "heightIn": 0.23,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "text": {
            "type": "string",
            "x-designSlot": "FootText{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.06,
              "heightIn": 0.72,
              "lineHeight": 1.15,
              "maxLines": 4
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json"
}
