{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideCompareSlide data",
  "type": "object",
  "required": ["left", "right"],
  "properties": {
    "section": { "type": "string" },
    "page": { "type": "string" },
    "left": { "$ref": "#/definitions/panel" },
    "right": { "$ref": "#/definitions/panel" },
    "footerLeft": { "type": "string" },
    "footerRight": { "type": "string" }
  },
  "definitions": {
    "panel": {
      "type": "object",
      "required": ["label", "title", "body", "bullets"],
      "properties": {
        "label": { "type": "string" },
        "title": {
          "type": "string",
          "x-slotBudget": { "fontPt": 24, "maxLines": 2, "widthIn": 4.8 }
        },
        "body": {
          "type": "string",
          "x-slotBudget": { "fontPt": 13, "maxLines": 3, "widthIn": 4.9 }
        },
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string",
            "x-slotBudget": { "fontPt": 10.5, "maxLines": 2, "widthIn": 4.6 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
