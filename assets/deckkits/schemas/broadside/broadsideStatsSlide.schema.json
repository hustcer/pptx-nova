{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideStatsSlide data",
  "type": "object",
  "required": ["items"],
  "properties": {
    "section": { "type": "string" },
    "page": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "x-slotBudget": { "fontPt": 40, "maxLines": 1, "widthIn": 3.5 }
          },
          "label": {
            "type": "string",
            "x-slotBudget": { "fontPt": 11.5, "maxLines": 2, "widthIn": 3.5 }
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "footerLeft": { "type": "string" },
    "footerRight": { "type": "string" }
  },
  "additionalProperties": false
}
