{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/profileTableSlide",
  "title": "profileTableSlide data schema",
  "type": "object",
  "required": ["eyebrow", "title", "rows"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "rows": {
      "type": "array",
      "description": "Tuple: [period, org, role]",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "string" }
      }
    },
    "cards": {
      "type": "array",
      "description": "Tuple: [accent, num, label, desc]",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
