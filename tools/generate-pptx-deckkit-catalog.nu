#!/usr/bin/env nu

const deckkit_catalog_path = "pptx-nova/assets/deckkits/catalog.json"
const theme_catalog_path = "pptx-nova/assets/themes/catalog.json"

def string-literal [value: string]: nothing -> string {
  $value | to json --raw
}

def require-record [kind: string, value: any]: nothing -> nothing {
  if not (($value | describe) | str starts-with "record") {
    error make { msg: $"($kind) must be an object, got ($value | describe)" }
  }
}

def require-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  let keys = ($row | columns)
  let missing = ($fields | where {|field| not ($keys | any {|key| $key == $field }) })
  if (($missing | length) > 0) {
    error make {
      msg: $"($kind) `($row.id? | default "<missing-id>")` is missing fields: ($missing | str join ', ')"
    }
  }
}

def reject-extra-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  let keys = ($row | columns)
  let extra = ($keys | where {|key| not ($fields | any {|field| $field == $key }) })
  if (($extra | length) > 0) {
    error make {
      msg: $"($kind) has unsupported fields: ($extra | str join ', ')"
    }
  }
}

def require-exact-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  require-fields $kind $row $fields
  reject-extra-fields $kind $row $fields
}

def duplicate-ids [rows: list<record>]: nothing -> list<string> {
  $rows
  | group-by id
  | transpose id entries
  | where {|row| ($row.entries | length) > 1 }
  | get id?
  | default []
}

def ids [rows: list<record>]: nothing -> list<string> {
  $rows | each {|row| $row.id }
}

def validate-native-skinning [
  entry: record
  theme_ids: list<string>
  style_ids: list<string>
]: nothing -> nothing {
  require-record $"DeckKit `($entry.id)`.nativeSkinning" $entry.nativeSkinning
  require-exact-fields $"DeckKit `($entry.id)`.nativeSkinning" $entry.nativeSkinning [
    "themePack" "stylePack" "chromeSource"
  ]
  if not ($theme_ids | any {|id| $id == $entry.nativeSkinning.themePack }) {
    error make {
      msg: $"DeckKit `($entry.id)` nativeSkinning.themePack references unknown themePack `($entry.nativeSkinning.themePack)`"
    }
  }
  if not ($style_ids | any {|id| $id == $entry.nativeSkinning.stylePack }) {
    error make {
      msg: $"DeckKit `($entry.id)` nativeSkinning.stylePack references unknown stylePack `($entry.nativeSkinning.stylePack)`"
    }
  }
}

def native-entries [catalog: record]: nothing -> list<record> {
  $catalog.entries
  | where {|entry| (($entry.nativeSkinning? | default null) != null) }
}

def render-native-entry [entry: record]: nothing -> string {
  let source = $"($deckkit_catalog_path)#entries.($entry.id).nativeSkinning"
  [
    "    {"
    $"      id: (string-literal $entry.id),"
    $"      readiness: (string-literal $entry.readiness),"
    $"      deckkit_path: (string-literal $entry.path),"
    $"      theme_pack: (string-literal $entry.nativeSkinning.themePack),"
    $"      style_pack: (string-literal $entry.nativeSkinning.stylePack),"
    $"      catalog_source: (string-literal $source),"
    $"      chrome_source: (string-literal $entry.nativeSkinning.chromeSource),"
    "    },"
  ] | str join "\n"
}

def render-moonbit-catalog [entries: list<record>]: nothing -> string {
  let rendered = ($entries | each {|entry| render-native-entry $entry } | str join "\n")
  [
    "///|"
    "// Generated by `nu tools/generate-pptx-deckkit-catalog.nu` from"
    $"// `($deckkit_catalog_path)`. Do not edit by hand."
    ""
    "///|"
    "fn pptx_builtin_native_deckkits() -> Array[PptxNativeDeckkit] {"
    "  ["
    $rendered
    "  ]"
    "}"
    ""
  ] | str join "\n"
}

def format-moonbit-content [content: string]: nothing -> string {
  ($content | ^moonfmt - -file-type mbt) + "\n"
}

def sync-output [path: string, content: string, check: bool]: nothing -> record {
  let current = if ($path | path exists) { open --raw $path } else { "" }
  let changed = ($current != $content)
  if $changed and (not $check) {
    $content | save --force $path
  }
  {path: $path, changed: $changed}
}

def main [
  --check # Only verify generated output is up to date.
  --moonbit-output: string # Override the generated xdoc catalog path.
]: nothing -> record {
  let resolved_moonbit_output = (
    $moonbit_output
    | default (($env.PPTX_REPO_ROOT? | default "../pptx") | path join "s8fy" "cmd" "main" "pptx_deckkit_catalog.generated.mbt")
  )
  let deckkit_catalog = (open $deckkit_catalog_path)
  let theme_catalog = (open $theme_catalog_path)
  if $deckkit_catalog.schemaVersion != "pptx-nova-deckkit-catalog/v1" {
    error make { msg: $"unexpected DeckKit schemaVersion: ($deckkit_catalog.schemaVersion)" }
  }
  if $theme_catalog.schemaVersion != "pptx-theme-catalog/v1" {
    error make { msg: $"unexpected theme schemaVersion: ($theme_catalog.schemaVersion)" }
  }
  let native = (native-entries $deckkit_catalog)
  let duplicates = (duplicate-ids $native)
  if (($duplicates | length) > 0) {
    error make { msg: $"duplicate native DeckKit ids: ($duplicates | str join ', ')" }
  }
  let theme_ids = (ids $theme_catalog.themePacks)
  let style_ids = (ids $theme_catalog.stylePacks)
  for entry in $native {
    require-fields "DeckKit native skinning entry" $entry [
      "id" "path" "readiness" "nativeSkinning"
    ]
    validate-native-skinning $entry $theme_ids $style_ids
  }
  let content = (format-moonbit-content (render-moonbit-catalog $native))
  let result = (sync-output $resolved_moonbit_output $content $check)
  if $check and $result.changed {
    error make { msg: ($result | to json --raw) }
  }
  {
    schemaVersion: "pptx-deckkit-catalog-sync/v1"
    checked: $check
    output: $result
    nativeDeckkits: ($native | each {|entry| $entry.id })
  }
}
