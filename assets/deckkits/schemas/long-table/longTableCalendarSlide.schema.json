{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableCalendarSlide",
  "title": "longTableCalendarSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "columns", "rows"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 48,
      "x-slotBudget": { "maxLines": 1, "fontPt": 37, "widthIn": 5.2 }
    },
    "subtitle": { "type": "string", "maxLength": 56 },
    "columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 16 }
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": { "type": "string", "maxLength": 80 }
      }
    }
  },
  "additionalProperties": false
}
