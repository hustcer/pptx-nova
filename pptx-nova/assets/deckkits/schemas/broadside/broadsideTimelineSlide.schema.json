{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideTimelineSlide data",
  "type": "object",
  "required": ["title", "events"],
  "properties": {
    "section": { "type": "string" },
    "page": { "type": "string" },
    "title": { "type": "string", "x-slotBudget": { "fontPt": 32, "maxLines": 1, "widthIn": 6.8 } },
    "events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["date", "title", "body"],
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "x-slotBudget": { "fontPt": 10.5, "maxLines": 2, "widthIn": 6.7 }
          }
        },
        "additionalProperties": false
      }
    },
    "footerLeft": { "type": "string" },
    "footerRight": { "type": "string" }
  },
  "additionalProperties": false
}
