{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monochrome list",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "pattern": "\\S",
      "description": "Content-owned structural label; Latin uppercase is an authoring preference, never an automatic transform.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "pattern": "\\S",
      "description": "Preserved heading or quotation, including intentional line breaks.",
      "x-slotBudget": {
        "fontPt": 30.72,
        "widthIn": 4.15,
        "heightIn": 1.6,
        "lineHeight": 1.08,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "pattern": "\\S",
      "description": "Provenance/date/qualification; synthetic samples must be identified explicitly.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.733,
        "heightIn": 0.32,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "body": {
      "type": "string",
      "pattern": "\\S",
      "description": "Visible supporting prose or attribution; input is never silently shortened.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4.15,
        "heightIn": 1.8,
        "lineHeight": 1.15,
        "maxLines": 7
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S",
        "description": "Recommendation",
        "x-slotBudget": {
          "fontPt": 14.4,
          "widthIn": 5.5760000000000005,
          "heightIn": 0.744,
          "lineHeight": 1.15,
          "maxLines": 2
        }
      },
      "minItems": 2,
      "maxItems": 5
    }
  },
  "required": ["section", "title", "source", "body", "items"],
  "additionalProperties": false
}
