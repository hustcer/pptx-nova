{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleCalendarSlide",
  "title": "biennaleCalendarSlide data schema",
  "type": "object",
  "required": ["title", "label", "columns", "rows"],
  "properties": {
    "title": {
      "type": "string",
      "x-slotBudget": { "maxLines": 2, "fontPt": 42, "widthIn": 3.4 }
    },
    "label": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.55 }
    },
    "columns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 6.15 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["date", "title", "venue", "length"],
        "properties": {
          "date": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9.8, "widthIn": 0.86 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 17.2, "widthIn": 6.25 }
          },
          "venue": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 10.5, "widthIn": 3.45 }
          },
          "length": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.75 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
