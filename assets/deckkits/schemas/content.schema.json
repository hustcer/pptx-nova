{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-content/v1",
  "title": "pptx-nova content manifest",
  "type": "object",
  "required": ["meta", "slides"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["deckkit"],
      "properties": {
        "deckkit": { "type": "string" },
        "style": { "type": "string" },
        "layout": { "type": "string" },
        "footerLeft": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "heroSlide",
              "profileTableSlide",
              "kpiRowSlide",
              "previewProductSlide",
              "multiCardSlide",
              "landscapeSlide",
              "convertFlowSlide",
              "benchmarkSlide",
              "timelineSlide",
              "askSlide",
              "mckCoverSlide",
              "mckCrisisSnapshotSlide",
              "mckDemographicProfileSlide",
              "mckPriorityMatrixSlide",
              "mckLossDriverSlide",
              "mckPillarsSlide",
              "mckInitiativeRankingSlide",
              "mckRoadmapSlide",
              "swissCoverSlide",
              "swissQuoteSlide",
              "swissTimelineSlide",
              "swissPrinciplesSlide",
              "swissPeopleGridSlide",
              "swissProfileSlide",
              "swissTypefaceSlide",
              "swissGridTypesSlide",
              "swissSystemSlide",
              "swissStatementSlide",
              "swissColumnSlide",
              "swissProgressSlide",
              "swissBrandGridSlide",
              "swissClosingSlide"
            ]
          },
          "data": { "type": "object" },
          "layoutId": {
            "type": "string",
            "description": "Optional DeckKit layout contract id when a slide type has multiple locked variants."
          },
          "rhythm": {
            "type": "string",
            "enum": ["anchor", "dense", "breathing"],
            "description": "Narrative rhythm used by DeckKit diversity and QA gates."
          },
          "assets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Asset ids referenced by this slide; each id must be present in assets_manifest.json when provided."
          },
          "imageSlots": {
            "type": "object",
            "description": "Map of semantic image slot id to asset id for image/screenshot-bearing DeckKit pages.",
            "additionalProperties": { "type": "string" }
          },
          "customOps": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
