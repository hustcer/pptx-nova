{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissBrandGridSlide",
  "title": "swissBrandGridSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "brands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "x-slotBudget": { "maxItems": 6 },
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 11.5, "widthIn": 1.9 }
          },
          "meta": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 6.8, "widthIn": 1.9 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 3, "fontPt": 7.1, "widthIn": 1.8 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
