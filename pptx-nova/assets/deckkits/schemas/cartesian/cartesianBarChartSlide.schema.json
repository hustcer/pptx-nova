{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianBarChartSlide",
  "title": "cartesianBarChartSlide data schema",
  "type": "object",
  "required": ["label", "title", "body", "chart"],
  "properties": {
    "label": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 4.5 } },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 36, "widthIn": 5.3 } },
    "body": { "type": "string", "x-slotBudget": { "maxLines": 4, "fontPt": 13, "widthIn": 4.5 } },
    "chart": {
      "type": "object",
      "required": ["categories", "series"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 0.7 }
          }
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "properties": {
              "name": {
                "type": "string",
                "x-slotBudget": { "maxLines": 1, "fontPt": 10, "widthIn": 1.4 }
              },
              "values": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": { "type": "number" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
