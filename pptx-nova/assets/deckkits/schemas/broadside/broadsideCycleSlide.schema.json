{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideCycleSlide data",
  "type": "object",
  "required": ["title", "steps"],
  "properties": {
    "section": { "type": "string" },
    "page": { "type": "string" },
    "title": { "type": "string", "x-slotBudget": { "fontPt": 32, "maxLines": 1, "widthIn": 7 } },
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "num": { "type": "string" },
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "x-slotBudget": { "fontPt": 10.5, "maxLines": 3, "widthIn": 4.8 }
          }
        },
        "additionalProperties": false
      }
    },
    "footerLeft": { "type": "string" },
    "footerRight": { "type": "string" }
  },
  "additionalProperties": false
}
