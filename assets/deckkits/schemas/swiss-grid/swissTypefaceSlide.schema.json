{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissTypefaceSlide",
  "title": "swissTypefaceSlide data schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8.8, "widthIn": 1.5 }
    },
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 6.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 11, "widthIn": 6.6 }
    },
    "sampleText": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "maxChars": 4, "fontPt": 54, "widthIn": 3.5 }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "x-slotBudget": { "maxItems": 3 },
      "items": {
        "type": "object",
        "properties": {
          "sampleText": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "maxChars": 4, "fontPt": 54, "widthIn": 3.5 }
          },
          "name": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 11.5, "widthIn": 3.5 }
          },
          "meta": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 7.1, "widthIn": 3.5 }
          },
          "weight": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 7.8, "widthIn": 3.5 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 5, "fontPt": 8.8, "widthIn": 3.4 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
