{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideSplitSlide data",
  "type": "object",
  "required": ["kicker", "title", "lead", "bullets"],
  "properties": {
    "section": { "type": "string" },
    "page": { "type": "string" },
    "kicker": { "type": "string" },
    "title": { "type": "string", "x-slotBudget": { "fontPt": 32, "maxLines": 3, "widthIn": 4.1 } },
    "lead": { "type": "string", "x-slotBudget": { "fontPt": 14, "maxLines": 3, "widthIn": 4.4 } },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "x-slotBudget": { "fontPt": 11, "maxLines": 2, "widthIn": 4.2 } }
    },
    "imageLabel": { "type": "string" },
    "caption": { "type": "string" },
    "footerLeft": { "type": "string" },
    "footerRight": { "type": "string" }
  },
  "additionalProperties": false
}
