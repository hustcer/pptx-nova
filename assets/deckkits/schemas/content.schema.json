{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-content/v1",
  "title": "pptx-nova content manifest",
  "type": "object",
  "required": ["meta", "slides"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["deckkit"],
      "properties": {
        "deckkit": { "type": "string" },
        "style": { "type": "string" },
        "layout": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "heroSlide",
              "profileTableSlide",
              "kpiRowSlide",
              "previewProductSlide",
              "multiCardSlide",
              "landscapeSlide",
              "convertFlowSlide",
              "benchmarkSlide",
              "timelineSlide",
              "askSlide",
              "mckCoverSlide",
              "mckCrisisSnapshotSlide",
              "mckDemographicProfileSlide",
              "mckPriorityMatrixSlide",
              "mckLossDriverSlide",
              "mckPillarsSlide",
              "mckInitiativeRankingSlide",
              "mckRoadmapSlide"
            ]
          },
          "data": { "type": "object" },
          "customOps": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
