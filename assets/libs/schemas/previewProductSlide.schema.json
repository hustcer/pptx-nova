{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/previewProductSlide",
  "title": "previewProductSlide data schema",
  "type": "object",
  "required": ["eyebrow", "title", "kpis"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "banner": { "type": "string" },
    "kpis": {
      "type": "array",
      "description": "Tuple: [accent, value, label, note]",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string" }
      }
    },
    "capHeader": { "type": "string" },
    "capLeft": { "type": "array", "items": { "type": "string" } },
    "capRight": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
