{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monochrome quote",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "pattern": "\\S",
      "description": "Content-owned structural label; Latin uppercase is an authoring preference, never an automatic transform.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.4,
        "heightIn": 0.35,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "pattern": "\\S",
      "description": "Preserved heading or quotation, including intentional line breaks.",
      "x-slotBudget": {
        "fontPt": 31,
        "widthIn": 9.4,
        "heightIn": 2.75,
        "lineHeight": 1.08,
        "maxLines": 5
      }
    },
    "source": {
      "type": "string",
      "pattern": "\\S",
      "description": "Provenance/date/qualification; synthetic samples must be identified explicitly.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.4,
        "heightIn": 0.35,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "body": {
      "type": "string",
      "pattern": "\\S",
      "description": "Visible supporting prose or attribution; input is never silently shortened.",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.4,
        "heightIn": 0.55,
        "lineHeight": 1.15,
        "maxLines": 2
      }
    }
  },
  "required": ["section", "title", "source", "body"],
  "additionalProperties": false
}
