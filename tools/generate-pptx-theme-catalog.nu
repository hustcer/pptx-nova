#!/usr/bin/env nu

const catalog_path = "pptx-nova/assets/themes/catalog.json"
const js_output = "pptx-nova/assets/examples/theme-packs.generated.mjs"

def string-literal [value: string]: nothing -> string {
  $value | to json --raw
}

def render-string-list [values: list<string>]: nothing -> string {
  if (($values | length) == 0) {
    "[]"
  } else {
    let items = ($values | each {|value| string-literal $value } | str join ", ")
    $"[($items)]"
  }
}

def render-string-map [values: record]: nothing -> string {
  let keys = ($values | columns)
  if (($keys | length) == 0) {
    "{}"
  } else {
    let lines = (
      $keys
      | each {|key|
        let value = ($values | get $key)
        $"        (string-literal $key): (string-literal $value),"
      }
    )
    $"{
($lines | str join "\n")
      }"
  }
}

def render-json-value [value: any]: nothing -> string {
  let type_name = ($value | describe)
  if ($type_name | str starts-with "record") {
    let fields = (
      $value
      | items {|key, item| $"(string-literal $key): (render-json-value $item)" }
      | str join ", "
    )
    "object_json({" + $fields + "})"
  } else if ($type_name | str starts-with "list") {
    let items = ($value | each {|item| render-json-value $item } | str join ", ")
    $"Json::array([($items)])"
  } else if $type_name == "string" {
    "Json(" + (string-literal $value) + ")"
  } else if $type_name == "bool" {
    "Json(" + ($value | to text) + ")"
  } else if ($type_name == "int") or ($type_name == "float") {
    "Json(" + ($value | to text) + ")"
  } else if $type_name == "nothing" {
    "Json::null()"
  } else {
    error make { msg: $"unsupported JSON value type in theme catalog: ($type_name)" }
  }
}

def render-theme-pack [pack: record]: nothing -> string {
  let generator_colors = ($pack.generator.colors? | default {})
  let generator_sizes = ($pack.generator.sizes? | default {})
  [
    "    {"
    $"      id: (string-literal $pack.id),"
    $"      name: (string-literal $pack.name),"
    $"      description: (string-literal $pack.description),"
    $"      use_cases: (render-string-list $pack.useCases),"
    $"      colors: (render-string-map $pack.colors),"
    $"      fonts: (render-string-map $pack.fonts),"
    $"      background: (string-literal $pack.background),"
    $"      title_style: (render-json-value $pack.titleStyle),"
    $"      body_style: (render-json-value $pack.bodyStyle),"
    $"      generator_colors: (render-string-map $generator_colors),"
    $"      generator_sizes: (render-string-map $generator_sizes),"
    $"      chart_palette: (render-string-list $pack.chartPalette),"
    $"      icon_style: (string-literal $pack.iconStyle),"
    "    },"
  ] | str join "\n"
}

def render-style-pack [pack: record]: nothing -> string {
  let generator_sizes = ($pack.generator.sizes? | default {})
  let generator_layout = ($pack.generator.layout? | default {})
  let generator_surface = ($pack.generator.surface? | default {})
  let generator_effects = ($pack.generator.effects? | default {})
  let generator_chrome = ($pack.generator.chrome? | default {})
  let generator_chart = ($pack.generator.chart? | default {})
  [
    "    {"
    $"      id: (string-literal $pack.id),"
    $"      name: (string-literal $pack.name),"
    $"      description: (string-literal $pack.description),"
    $"      density: (string-literal $pack.density),"
    $"      radius: (string-literal $pack.radius),"
    $"      stroke: (string-literal $pack.stroke),"
    $"      shadow: (string-literal $pack.shadow),"
    $"      image_ratio: (string-literal $pack.imageRatio),"
    $"      header_footer: (string-literal $pack.headerFooter),"
    $"      title_style: (render-json-value $pack.titleStyle),"
    $"      body_style: (render-json-value $pack.bodyStyle),"
    $"      generator_sizes: (render-string-map $generator_sizes),"
    $"      generator_layout: (render-json-value $generator_layout),"
    $"      generator_surface: (render-json-value $generator_surface),"
    $"      generator_effects: (render-json-value $generator_effects),"
    $"      generator_chrome: (render-json-value $generator_chrome),"
    $"      generator_chart: (render-json-value $generator_chart),"
    "    },"
  ] | str join "\n"
}

def render-moonbit-catalog [catalog: record]: nothing -> string {
  let theme_entries = ($catalog.themePacks | each {|pack| render-theme-pack $pack } | str join "\n")
  let style_entries = ($catalog.stylePacks | each {|pack| render-style-pack $pack } | str join "\n")
  [
    "///|"
    "// Generated by `nu tools/generate-pptx-theme-catalog.nu` from"
    $"// `($catalog_path)`. Do not edit by hand."
    ""
    "///|"
    "fn pptx_builtin_theme_packs() -> Array[PptxThemePack] {"
    "  ["
    $theme_entries
    "  ]"
    "}"
    ""
    "///|"
    "fn pptx_builtin_style_packs() -> Array[PptxStylePack] {"
    "  ["
    $style_entries
    "  ]"
    "}"
    ""
  ] | str join "\n"
}

def format-moonbit-content [content: string]: nothing -> string {
  ($content | ^moonfmt - -file-type mbt) + "\n"
}

def keyed-by-id [rows: list<record>]: nothing -> record {
  $rows | reduce --fold {} {|row, acc| $acc | insert $row.id $row }
}

def render-js-catalog [catalog: record]: nothing -> string {
  let theme_packs = (keyed-by-id $catalog.themePacks)
  let style_packs = (keyed-by-id $catalog.stylePacks)
  [
    "// Generated by `nu tools/generate-pptx-theme-catalog.nu` from"
    $"// `($catalog_path)`. Do not edit by hand."
    ""
    $"export const BUILTIN_THEME_PACKS = ($theme_packs | to json --indent 2)"
    ""
    $"export const BUILTIN_STYLE_PACKS = ($style_packs | to json --indent 2)"
    ""
  ] | str join "\n"
}

def duplicate-ids [rows: list<record>]: nothing -> list<string> {
  $rows
  | group-by id
  | transpose id entries
  | where {|row| ($row.entries | length) > 1 }
  | get id?
  | default []
}

def require-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  let keys = ($row | columns)
  let missing = ($fields | where {|field| not ($keys | any {|key| $key == $field }) })
  if (($missing | length) > 0) {
    error make {
      msg: $"($kind) `($row.id? | default "<missing-id>")` is missing fields: ($missing | str join ', ')"
    }
  }
}

def reject-extra-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  let keys = ($row | columns)
  let extra = ($keys | where {|key| not ($fields | any {|field| $field == $key }) })
  if (($extra | length) > 0) {
    error make {
      msg: $"($kind) has unsupported fields: ($extra | str join ', ')"
    }
  }
}

def require-exact-fields [kind: string, row: record, fields: list<string>]: nothing -> nothing {
  require-fields $kind $row $fields
  reject-extra-fields $kind $row $fields
}

def require-record [kind: string, value: any]: nothing -> nothing {
  if not (($value | describe) | str starts-with "record") {
    error make { msg: $"($kind) must be an object, got ($value | describe)" }
  }
}

def validate-string-enum [kind: string, value: any, allowed: list<string>]: nothing -> nothing {
  if ($value | describe) != "string" {
    error make { msg: $"($kind) must be a string, got ($value | describe)" }
  }
  if not ($allowed | any {|item| $item == $value }) {
    error make { msg: $"($kind) must be one of ($allowed | str join ', '), got `($value)`" }
  }
}

def validate-bool [kind: string, value: any]: nothing -> nothing {
  if ($value | describe) != "bool" {
    error make { msg: $"($kind) must be a boolean, got ($value | describe)" }
  }
}

def validate-number-range [
  kind: string
  value: any
  min: float
  max: float
]: nothing -> nothing {
  let type_name = ($value | describe)
  if not (($type_name == "int") or ($type_name == "float")) {
    error make { msg: $"($kind) must be a number, got ($type_name)" }
  }
  let numeric = ($value | into float)
  if ($numeric < $min) or ($numeric > $max) {
    error make { msg: $"($kind) must be between ($min) and ($max), got ($numeric)" }
  }
}

def validate-pt-string [kind: string, value: any]: nothing -> nothing {
  if ($value | describe) != "string" {
    error make { msg: $"($kind) must be a pt string, got ($value | describe)" }
  }
  if not ($value =~ '^[0-9]+(\.[0-9]+)?pt$') {
    error make { msg: $"($kind) must match /^[0-9]+(\\.[0-9]+)?pt$/, got `($value)`" }
  }
}

def validate-hex-color [kind: string, value: any]: nothing -> nothing {
  if ($value | describe) != "string" {
    error make { msg: $"($kind) must be a hex RGB string, got ($value | describe)" }
  }
  if not ($value =~ '^#?[0-9A-Fa-f]{6}$') {
    error make { msg: $"($kind) must match /^#?[0-9A-Fa-f]{6}$/, got `($value)`" }
  }
}

def validate-size-map [kind: string, values: record]: nothing -> nothing {
  for entry in ($values | transpose key value) {
    validate-pt-string $"($kind).($entry.key)" $entry.value
  }
}

def validate-shadow-token [kind: string, value: any]: nothing -> nothing {
  let type_name = ($value | describe)
  if $type_name == "nothing" {
    return
  }
  require-record $kind $value
  let fields = ["color" "alpha" "blur" "distance" "angle"]
  require-exact-fields $kind $value $fields
  validate-hex-color $"($kind).color" $value.color
  validate-number-range $"($kind).alpha" $value.alpha 0.0 1.0
  validate-pt-string $"($kind).blur" $value.blur
  validate-pt-string $"($kind).distance" $value.distance
  validate-number-range $"($kind).angle" $value.angle 0.0 360.0
}

def validate-style-generator [pack: record]: nothing -> nothing {
  let generator = $pack.generator
  require-record $"stylePack `($pack.id)`.generator" $generator
  require-exact-fields $"stylePack `($pack.id)`.generator" $generator [
    "sizes" "layout" "surface" "effects" "chrome" "chart"
  ]

  require-record $"stylePack `($pack.id)`.generator.sizes" $generator.sizes
  validate-size-map $"stylePack `($pack.id)`.generator.sizes" $generator.sizes

  require-record $"stylePack `($pack.id)`.generator.layout" $generator.layout
  require-exact-fields $"stylePack `($pack.id)`.generator.layout" $generator.layout [
    "marginX" "gridGap" "rowGap" "cardPadX" "cardPadY"
    "agendaRowH" "kpiCardH" "pillarCardH" "workflowCardH"
  ]
  validate-number-range $"stylePack `($pack.id)`.generator.layout.marginX" $generator.layout.marginX 0.0 2.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.gridGap" $generator.layout.gridGap 0.0 1.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.rowGap" $generator.layout.rowGap 0.0 1.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.cardPadX" $generator.layout.cardPadX 0.0 1.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.cardPadY" $generator.layout.cardPadY 0.0 1.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.agendaRowH" $generator.layout.agendaRowH 0.1 6.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.kpiCardH" $generator.layout.kpiCardH 0.1 6.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.pillarCardH" $generator.layout.pillarCardH 0.1 6.0
  validate-number-range $"stylePack `($pack.id)`.generator.layout.workflowCardH" $generator.layout.workflowCardH 0.1 6.0

  require-record $"stylePack `($pack.id)`.generator.surface" $generator.surface
  require-exact-fields $"stylePack `($pack.id)`.generator.surface" $generator.surface [
    "cardShape" "panelShape" "cardLine" "cardLineWidth" "accentBarH"
  ]
  validate-string-enum $"stylePack `($pack.id)`.generator.surface.cardShape" $generator.surface.cardShape [
    "rectangle" "rounded-rectangle"
  ]
  validate-string-enum $"stylePack `($pack.id)`.generator.surface.panelShape" $generator.surface.panelShape [
    "rectangle" "rounded-rectangle"
  ]
  validate-bool $"stylePack `($pack.id)`.generator.surface.cardLine" $generator.surface.cardLine
  validate-pt-string $"stylePack `($pack.id)`.generator.surface.cardLineWidth" $generator.surface.cardLineWidth
  validate-number-range $"stylePack `($pack.id)`.generator.surface.accentBarH" $generator.surface.accentBarH 0.0 0.5

  require-record $"stylePack `($pack.id)`.generator.effects" $generator.effects
  require-exact-fields $"stylePack `($pack.id)`.generator.effects" $generator.effects [
    "cardShadow" "panelShadow"
  ]
  validate-shadow-token $"stylePack `($pack.id)`.generator.effects.cardShadow" $generator.effects.cardShadow
  validate-shadow-token $"stylePack `($pack.id)`.generator.effects.panelShadow" $generator.effects.panelShadow

  require-record $"stylePack `($pack.id)`.generator.chrome" $generator.chrome
  require-exact-fields $"stylePack `($pack.id)`.generator.chrome" $generator.chrome [
    "topBarH" "headerAccentW" "headerAccentH" "footerY" "watermark"
  ]
  validate-number-range $"stylePack `($pack.id)`.generator.chrome.topBarH" $generator.chrome.topBarH 0.0 0.5
  validate-number-range $"stylePack `($pack.id)`.generator.chrome.headerAccentW" $generator.chrome.headerAccentW 0.0 0.5
  validate-number-range $"stylePack `($pack.id)`.generator.chrome.headerAccentH" $generator.chrome.headerAccentH 0.0 1.5
  validate-number-range $"stylePack `($pack.id)`.generator.chrome.footerY" $generator.chrome.footerY 0.0 7.5
  validate-bool $"stylePack `($pack.id)`.generator.chrome.watermark" $generator.chrome.watermark

  require-record $"stylePack `($pack.id)`.generator.chart" $generator.chart
  require-exact-fields $"stylePack `($pack.id)`.generator.chart" $generator.chart [
    "panelW" "calloutW"
  ]
  validate-number-range $"stylePack `($pack.id)`.generator.chart.panelW" $generator.chart.panelW 1.0 12.0
  validate-number-range $"stylePack `($pack.id)`.generator.chart.calloutW" $generator.chart.calloutW 1.0 6.0
}

def validate-catalog [catalog: record]: nothing -> nothing {
  if $catalog.schemaVersion != "pptx-theme-catalog/v1" {
    error make { msg: $"unexpected schemaVersion: ($catalog.schemaVersion)" }
  }

  let theme_duplicates = (duplicate-ids $catalog.themePacks)
  if (($theme_duplicates | length) > 0) {
    error make { msg: $"duplicate themePack ids: ($theme_duplicates | str join ', ')" }
  }

  let style_duplicates = (duplicate-ids $catalog.stylePacks)
  if (($style_duplicates | length) > 0) {
    error make { msg: $"duplicate stylePack ids: ($style_duplicates | str join ', ')" }
  }

  let theme_fields = [
    "id" "name" "type" "description" "useCases" "colors" "fonts"
    "background" "titleStyle" "bodyStyle" "generator" "chartPalette"
    "iconStyle"
  ]
  let style_fields = [
    "id" "name" "type" "description" "density" "radius" "stroke"
    "shadow" "imageRatio" "headerFooter" "titleStyle" "bodyStyle"
    "generator"
  ]
  for pack in $catalog.themePacks {
    require-fields "themePack" $pack $theme_fields
    if $pack.type != "themePack" {
      error make { msg: $"themePack `($pack.id)` has invalid type `($pack.type)`" }
    }
  }
  for pack in $catalog.stylePacks {
    require-fields "stylePack" $pack $style_fields
    if $pack.type != "stylePack" {
      error make { msg: $"stylePack `($pack.id)` has invalid type `($pack.type)`" }
    }
    validate-style-generator $pack
  }
}

def sync-output [path: string, content: string, check: bool]: nothing -> record {
  let current = if ($path | path exists) { open --raw $path } else { "" }
  let changed = ($current != $content)
  if $changed and (not $check) {
    $content | save --force $path
  }
  {path: $path, changed: $changed}
}

def main [
  --check # Only verify generated outputs are up to date.
  --moonbit-output: string # Override the generated xdoc catalog path.
  --skip-moonbit # Only sync pptx-nova skill outputs.
]: nothing -> record {
  let resolved_moonbit_output = (
    $moonbit_output
    | default (($env.PPTX_REPO_ROOT? | default "../pptx") | path join "s8fy" "cmd" "main" "pptx_theme_catalog.generated.mbt")
  )
  let catalog = (open $catalog_path)
  validate-catalog $catalog

  let outputs = if $skip_moonbit {
    [
      {path: $js_output, content: (render-js-catalog $catalog)}
    ]
  } else {
    let moonbit_content = (format-moonbit-content (render-moonbit-catalog $catalog))
    [
      {path: $resolved_moonbit_output, content: $moonbit_content}
      {path: $js_output, content: (render-js-catalog $catalog)}
    ]
  }
  let results = ($outputs | each {|output| sync-output $output.path $output.content $check })
  let stale = ($results | where changed)

  if $check and (($stale | length) > 0) {
    error make { msg: ($stale | to json --raw) }
  }

  {
    schemaVersion: "pptx-theme-catalog-sync/v1"
    checked: $check
    outputs: $results
  }
}
