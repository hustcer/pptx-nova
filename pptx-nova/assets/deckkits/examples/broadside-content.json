          {
            "num": "03",
            "title": "Design",
            "body": "Build the simplest thing that could prove or disprove the hypothesis. Skip the polish."
          },
          {
            "num": "04",
            "title": "Deploy",
            "body": "Ship to real users. Measure behavior, not opinions. Repeat from step one with new data."
          }
