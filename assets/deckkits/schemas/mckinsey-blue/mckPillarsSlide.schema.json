{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/mckinsey-blue/mckPillarsSlide",
  "title": "mckPillarsSlide data schema",
  "type": "object",
  "properties": {
    "title": { "type": "string", "x-slotBudget": { "maxLines": 2, "fontPt": 19, "widthIn": 10.5 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 8, "widthIn": 10.2 }
    },
    "defaultTimeframe": {
      "type": "string",
      "description": "pillars[].time 缺省时的统一时间范围回退值。",
      "x-slotFallbackOf": "pillars[].time",
      "x-slotBudget": { "maxLines": 1, "fontPt": 6.5, "widthIn": 2.4 }
    },
    "labels": { "type": "object" },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "x-slotBudget": { "maxItems": 4 },
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 10, "widthIn": 2.4 }
          },
          "body": {
            "type": "string",
            "x-slotBudget": { "maxLines": 4, "fontPt": 8.3, "widthIn": 2.3 }
          },
          "outcome": {
            "type": "string",
            "x-slotBudget": { "maxLines": 2, "fontPt": 8, "widthIn": 2.3 }
          },
          "kpi": {
            "type": "string",
            "x-slotBudget": { "maxLines": 3, "fontPt": 20, "widthIn": 2.3 }
          },
          "time": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 6.5, "widthIn": 2.3 }
          }
        },
        "additionalProperties": true
      }
    },
    "source": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 6.3, "widthIn": 4.7 } }
  },
  "additionalProperties": true
}
