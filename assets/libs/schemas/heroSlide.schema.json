{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/heroSlide",
  "title": "heroSlide data schema",
  "type": "object",
  "required": ["title"],
  "properties": {
    "eyebrow": { "type": "string" },
    "title": { "type": "string" },
    "sub": { "type": "string" },
    "tag": { "type": "string" },
    "infoL": { "type": "string" },
    "infoR": { "type": "string" },
    "variant": {
      "type": "string",
      "enum": ["cover", "closing"],
      "default": "cover"
    }
  },
  "additionalProperties": false
}
