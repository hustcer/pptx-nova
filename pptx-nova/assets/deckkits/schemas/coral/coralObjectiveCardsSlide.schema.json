{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralObjectiveCardsSlide",
  "title": "coralObjectiveCardsSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "cards"],
  "properties": {
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 32, "widthIn": 4.8 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 2, "fontPt": 10.5, "widthIn": 4.9 }
    },
    "cards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["marker", "title", "text", "stat"],
        "properties": {
          "marker": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.3 }
          },
          "title": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 18, "widthIn": 3.1 }
          },
          "text": {
            "type": "string",
            "x-slotBudget": { "maxLines": 5, "fontPt": 10.5, "widthIn": 3.1 }
          },
          "stat": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 22, "widthIn": 1.1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
