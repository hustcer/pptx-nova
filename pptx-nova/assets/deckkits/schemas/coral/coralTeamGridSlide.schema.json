{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/coral/coralTeamGridSlide",
  "title": "coralTeamGridSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "people"],
  "properties": {
    "title": { "type": "string", "x-slotBudget": { "maxLines": 1, "fontPt": 30, "widthIn": 3.6 } },
    "subtitle": {
      "type": "string",
      "x-slotBudget": { "maxLines": 1, "fontPt": 9.5, "widthIn": 3.2 }
    },
    "people": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["initials", "name", "role"],
        "properties": {
          "initials": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 0.44 }
          },
          "name": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.0 }
          },
          "role": {
            "type": "string",
            "x-slotBudget": { "maxLines": 1, "fontPt": 9, "widthIn": 2.0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
