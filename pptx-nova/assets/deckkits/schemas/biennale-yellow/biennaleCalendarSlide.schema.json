{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleCalendarSlide",
  "title": "biennaleCalendarSlide data schema",
  "type": "object",
  "required": ["title", "label", "columns", "rows"],
  "properties": {
    "title": {
      "type": "string",
      "x-designSlot": "Title",
      "x-slotBudget": {
        "fontPt": 38,
        "widthIn": 5.5,
        "heightIn": 0.75,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "x-designSlot": "Label",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2.55,
        "heightIn": 0.35,
        "lineHeight": 1.2,
        "maxLines": 2
      }
    },
    "columns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "x-designSlot": "Col{i}",
        "x-slotBudget": {
          "fontPt": 10,
          "widthIn": 0.74,
          "heightIn": 0.22,
          "lineHeight": 1.2,
          "maxLines": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["date", "title", "venue", "length"],
        "properties": {
          "date": {
            "type": "string",
            "x-designSlot": "Date{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 0.86,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "title": {
            "type": "string",
            "x-designSlot": "Event{i}",
            "x-slotBudget": {
              "fontPt": 17.2,
              "widthIn": 6.25,
              "heightIn": 0.34,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "venue": {
            "type": "string",
            "x-designSlot": "Venue{i}",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3.45,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "length": {
            "type": "string",
            "x-designSlot": "Length{i}",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 0.75,
              "heightIn": 0.22,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json"
}
